{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./out",
    // Keep the incremental-build state inside out/ so deleting out/ yields a
    // coherent clean state (a surviving tsbuildinfo would make tsc skip re-emit).
    "tsBuildInfoFile": "./out/tsconfig.tsbuildinfo",
    "lib": ["ES2021"],
    "types": ["node"],
    // The MCP SDK ships its subpaths via a package.json "exports" map, which only
    // node16/nodenext resolution understands. The runtime artifact is the esbuild
    // bundle (dist/opp_ide_mcp.js); this tsc build is for type-checking only.
    "module": "node16",
    "moduleResolution": "node16"
  },
  "references": [{ "path": "../shared" }],
  "include": ["src/**/*.ts"]
}
