{
  "name": "omnetpp-vscode",
  "displayName": "OMNeT++ Development Environment",
  "description": "Language server and editor support for the OMNeT++ NED, MSG and INI languages",
  "version": "0.4.0",
  "publisher": "opensim",
  "repository": "https://github.com/omnetpp/omnetpp-vscode",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "opp_lint": "./dist/opp_lint.js",
    "opp_neddoc": "./dist/opp_neddoc.js"
  },
  "activationEvents": [
    "workspaceContains:**/*.ned",
    "onLanguage:OMNeT++ NED",
    "onLanguage:OMNeT++ MSG",
    "onLanguage:OMNeT++ INI"
  ],
  "workspaces": [
    "shared",
    "server",
    "client",
    "mcp"
  ],
  "scripts": {
    "build:wasm": "bun ./scripts/build-wasm.mjs",
    "compile": "bun ./node_modules/typescript/bin/tsc --build",
    "watch": "bun ./node_modules/typescript/bin/tsc --build --watch",
    "bundle": "bun ./esbuild.mjs",
    "bundle:watch": "bun ./esbuild.mjs --watch",
    "dev:build": "bun run copy:assets && bun run bundle",
    "copy:assets": "bun ./scripts/copy-assets.mjs",
    "prepackage": "bun run compile && bun run build:wasm && bun run copy:assets && bun ./esbuild.mjs --production",
    "test": "bun run compile && bun test ./shared/src/test ./server/src/test ./client/webview/src/test",
    "package": "bun run prepackage && bun ./node_modules/@vscode/vsce/vsce package --no-dependencies",
    "deploy": "bun run prepackage && bun ./node_modules/@vscode/vsce/vsce publish --no-dependencies"
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "omnetpp.liveModel",
        "label": "OMNeT++ NED/MSG/INI (live)"
      }
    ],
    "languages": [
      {
        "id": "OMNeT++ NED",
        "extensions": [
          ".ned"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "OMNeT++ MSG",
        "extensions": [
          ".msg"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "OMNeT++ INI",
        "extensions": [
          ".ini"
        ],
        "configuration": "./language-configuration-ini.json"
      }
    ],
    "snippets": [
      {
        "language": "OMNeT++ NED",
        "path": "./snippets/ned.json"
      },
      {
        "language": "OMNeT++ INI",
        "path": "./snippets/ini.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omnetpp",
          "title": "OMNeT++",
          "icon": "media/omnetpp.svg"
        }
      ]
    },
    "views": {
      "omnetpp": [
        {
          "id": "omnetppActiveConfig",
          "name": "Configurations"
        },
        {
          "id": "omnetppModuleHierarchy",
          "name": "Module Hierarchy"
        },
        {
          "id": "omnetppModuleParams",
          "name": "Module Parameters"
        },
        {
          "id": "omnetppInheritance",
          "name": "NED Inheritance"
        },
        {
          "id": "omnetppUsedBy",
          "name": "Used By"
        }
      ]
    },
    "commands": [
      {
        "command": "omnetpp.showImpact",
        "title": "Show Impact (Reverse Dependencies)",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.pinType",
        "title": "Pin Type",
        "category": "OMNeT++",
        "icon": "$(pin)"
      },
      {
        "command": "omnetpp.unpinType",
        "title": "Unpin Type",
        "category": "OMNeT++",
        "icon": "$(pinned)"
      },
      {
        "command": "omnetpp.pinModule",
        "title": "Pin Module",
        "category": "OMNeT++",
        "icon": "$(pin)"
      },
      {
        "command": "omnetpp.unpinModule",
        "title": "Unpin Module",
        "category": "OMNeT++",
        "icon": "$(pinned)"
      },
      {
        "command": "omnetpp.pinParam",
        "title": "Pin Module",
        "category": "OMNeT++",
        "icon": "$(pin)"
      },
      {
        "command": "omnetpp.unpinParam",
        "title": "Unpin Module",
        "category": "OMNeT++",
        "icon": "$(pinned)"
      },
      {
        "command": "omnetpp.pinUsedBy",
        "title": "Pin",
        "category": "OMNeT++",
        "icon": "$(pin)"
      },
      {
        "command": "omnetpp.unpinUsedBy",
        "title": "Unpin",
        "category": "OMNeT++",
        "icon": "$(pinned)"
      },
      {
        "command": "omnetpp.setActiveConfiguration",
        "title": "Set as Active Configuration",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.clearActiveConfiguration",
        "title": "Clear Active Configuration",
        "category": "OMNeT++",
        "icon": "$(close)"
      },
      {
        "command": "omnetpp.setActiveConfigItem",
        "title": "Set as Active Config",
        "category": "OMNeT++",
        "icon": "$(check)"
      },
      {
        "command": "omnetpp.filterConfigurations",
        "title": "Filter Configurations",
        "category": "OMNeT++",
        "icon": "$(filter)"
      },
      {
        "command": "omnetpp.clearConfigurationsFilter",
        "title": "Clear Configurations Filter",
        "category": "OMNeT++",
        "icon": "$(clear-all)"
      },
      {
        "command": "omnetpp.refreshConfigurations",
        "title": "Refresh Configurations",
        "category": "OMNeT++",
        "icon": "$(refresh)"
      },
      {
        "command": "omnetpp.showNedPreview",
        "title": "Show Graphical Preview",
        "category": "OMNeT++",
        "icon": "$(open-preview)"
      },
      {
        "command": "omnetpp.previewShowType",
        "title": "Show",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.previewBack",
        "title": "Back",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.previewForward",
        "title": "Forward",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.previewRelayout",
        "title": "Re-layout",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.previewExportSvg",
        "title": "Export as SVG...",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.previewExportPng",
        "title": "Export as PNG...",
        "category": "OMNeT++"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "omnetpp.pinType", "when": "false" },
        { "command": "omnetpp.unpinType", "when": "false" },
        { "command": "omnetpp.pinModule", "when": "false" },
        { "command": "omnetpp.unpinModule", "when": "false" },
        { "command": "omnetpp.pinParam", "when": "false" },
        { "command": "omnetpp.unpinParam", "when": "false" },
        { "command": "omnetpp.pinUsedBy", "when": "false" },
        { "command": "omnetpp.unpinUsedBy", "when": "false" },
        { "command": "omnetpp.setActiveConfiguration", "when": "editorLangId == 'OMNeT++ INI'" },
        { "command": "omnetpp.clearActiveConfiguration", "when": "omnetpp.hasActiveConfig" },
        { "command": "omnetpp.setActiveConfigItem", "when": "false" },
        { "command": "omnetpp.filterConfigurations", "when": "true" },
        { "command": "omnetpp.clearConfigurationsFilter", "when": "omnetpp.configFilterActive" },
        { "command": "omnetpp.refreshConfigurations", "when": "true" },
        { "command": "omnetpp.showNedPreview", "when": "editorLangId == 'OMNeT++ NED'" },
        { "command": "omnetpp.previewShowType", "when": "false" },
        { "command": "omnetpp.previewBack", "when": "false" },
        { "command": "omnetpp.previewForward", "when": "false" },
        { "command": "omnetpp.previewRelayout", "when": "false" },
        { "command": "omnetpp.previewExportSvg", "when": "false" },
        { "command": "omnetpp.previewExportPng", "when": "false" }
      ],
      "webview/context": [
        {
          "command": "omnetpp.previewShowType",
          "when": "webviewId == 'omnetpp.nedPreview' && webviewSection == 'nedPreviewSub'",
          "group": "0_navigate@1"
        },
        {
          "command": "omnetpp.previewRelayout",
          "when": "webviewId == 'omnetpp.nedPreview' && webviewSection =~ /^nedPreview/",
          "group": "1_layout@1"
        },
        {
          "command": "omnetpp.previewExportSvg",
          "when": "webviewId == 'omnetpp.nedPreview' && webviewSection =~ /^nedPreview/",
          "group": "2_export@1"
        },
        {
          "command": "omnetpp.previewExportPng",
          "when": "webviewId == 'omnetpp.nedPreview' && webviewSection =~ /^nedPreview/",
          "group": "2_export@2"
        }
      ],
      "editor/context": [
        {
          "command": "omnetpp.showNedPreview",
          "when": "editorLangId == 'OMNeT++ NED'",
          "group": "navigation@1"
        },
        {
          "command": "omnetpp.setActiveConfiguration",
          "when": "editorLangId == 'OMNeT++ INI'",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "omnetpp.showNedPreview",
          "when": "editorLangId == 'OMNeT++ NED'",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "omnetpp.unpinType",
          "when": "view == omnetppInheritance && omnetpp.typePinned",
          "group": "navigation"
        },
        {
          "command": "omnetpp.unpinModule",
          "when": "view == omnetppModuleHierarchy && omnetpp.modulePinned",
          "group": "navigation"
        },
        {
          "command": "omnetpp.unpinParam",
          "when": "view == omnetppModuleParams && omnetpp.paramPinned",
          "group": "navigation"
        },
        {
          "command": "omnetpp.pinUsedBy",
          "when": "view == omnetppUsedBy && omnetpp.usedByHasTarget && !omnetpp.usedByPinned",
          "group": "navigation"
        },
        {
          "command": "omnetpp.unpinUsedBy",
          "when": "view == omnetppUsedBy && omnetpp.usedByPinned",
          "group": "navigation"
        },
        {
          "command": "omnetpp.filterConfigurations",
          "when": "view == omnetppActiveConfig",
          "group": "navigation@1"
        },
        {
          "command": "omnetpp.clearConfigurationsFilter",
          "when": "view == omnetppActiveConfig && omnetpp.configFilterActive",
          "group": "navigation@2"
        },
        {
          "command": "omnetpp.clearActiveConfiguration",
          "when": "view == omnetppActiveConfig && omnetpp.hasActiveConfig",
          "group": "navigation@3"
        },
        {
          "command": "omnetpp.refreshConfigurations",
          "when": "view == omnetppActiveConfig",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "omnetpp.setActiveConfigItem",
          "when": "view == omnetppActiveConfig && viewItem == omnetppConfig",
          "group": "inline"
        },
        {
          "command": "omnetpp.setActiveConfigItem",
          "when": "view == omnetppActiveConfig && viewItem == omnetppConfig",
          "group": "1_config"
        },
        {
          "command": "omnetpp.pinType",
          "when": "view == omnetppInheritance && viewItem == nedTypeUnpinned",
          "group": "inline"
        },
        {
          "command": "omnetpp.pinType",
          "when": "view == omnetppInheritance && viewItem == nedTypeUnpinned",
          "group": "1_pin"
        },
        {
          "command": "omnetpp.unpinType",
          "when": "view == omnetppInheritance && viewItem == nedTypePinned",
          "group": "inline"
        },
        {
          "command": "omnetpp.unpinType",
          "when": "view == omnetppInheritance && viewItem == nedTypePinned",
          "group": "1_pin"
        },
        {
          "command": "omnetpp.pinModule",
          "when": "view == omnetppModuleHierarchy && viewItem == nedModuleUnpinned",
          "group": "inline"
        },
        {
          "command": "omnetpp.pinModule",
          "when": "view == omnetppModuleHierarchy && viewItem == nedModuleUnpinned",
          "group": "1_pin"
        },
        {
          "command": "omnetpp.unpinModule",
          "when": "view == omnetppModuleHierarchy && viewItem == nedModulePinned",
          "group": "inline"
        },
        {
          "command": "omnetpp.unpinModule",
          "when": "view == omnetppModuleHierarchy && viewItem == nedModulePinned",
          "group": "1_pin"
        },
        {
          "command": "omnetpp.pinParam",
          "when": "view == omnetppModuleParams && viewItem == nedParamUnpinned",
          "group": "inline"
        },
        {
          "command": "omnetpp.pinParam",
          "when": "view == omnetppModuleParams && viewItem == nedParamUnpinned",
          "group": "1_pin"
        },
        {
          "command": "omnetpp.unpinParam",
          "when": "view == omnetppModuleParams && viewItem == nedParamPinned",
          "group": "inline"
        },
        {
          "command": "omnetpp.unpinParam",
          "when": "view == omnetppModuleParams && viewItem == nedParamPinned",
          "group": "1_pin"
        }
      ]
    },
    "grammars": [
      {
        "language": "OMNeT++ NED",
        "scopeName": "source.ned",
        "path": "./syntaxes/ned.tmLanguage.json",
        "unbalancedBracketScopes": ["comment", "string"]
      },
      {
        "language": "OMNeT++ MSG",
        "scopeName": "source.msg",
        "path": "./syntaxes/omnetpp-msg.tmLanguage.json",
        "unbalancedBracketScopes": ["comment", "string"]
      },
      {
        "language": "OMNeT++ INI",
        "scopeName": "source.omnetpp-ini",
        "path": "./syntaxes/omnetpp-ini.tmLanguage.json",
        "unbalancedBracketScopes": ["comment", "string"]
      }
    ],
    "keybindings": [
      {
        "command": "omnetpp.previewBack",
        "key": "alt+left",
        "mac": "ctrl+-",
        "when": "activeWebviewPanelId == 'omnetpp.nedPreview'"
      },
      {
        "command": "omnetpp.previewForward",
        "key": "alt+right",
        "mac": "ctrl+shift+-",
        "when": "activeWebviewPanelId == 'omnetpp.nedPreview'"
      }
    ],
    "configuration": {
      "title": "OMNeT++",
      "properties": {
        "omnetpp.nedPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Semicolon-separated list of additional NED source root directories (like the `ned-path` config option). Used in addition to source roots discovered from `.nedfolders`/`package.ned`."
        },
        "omnetpp.installDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to an OMNeT++ installation root. When set (or auto-detected), enables enriched features such as a live config-option registry and bundled NED libraries."
        },
        "omnetpp.diagnostics.scope": {
          "type": "string",
          "enum": [
            "workspace",
            "openFiles"
          ],
          "enumDescriptions": [
            "Report problems for every NED/MSG/INI file in the workspace, even ones that aren't open in an editor.",
            "Report problems only for files currently open in an editor."
          ],
          "default": "workspace",
          "markdownDescription": "Which files contribute problem markers to the Problems view. `workspace` analyses the whole project so errors in unopened files stay visible; `openFiles` restricts diagnostics to the editors you have open."
        },
        "omnetpp.codeLens.iniParams": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a CodeLens on INI parameter-assignment lines with the count of matching module parameters (in the network of the section, or of the active configuration for `[General]` lines). Clicking it peeks the matched NED parameter declarations."
        },
        "omnetpp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the OMNeT++ language server."
        }
      }
    }
  },
  "comment:trustedDependencies": "Intentionally empty: dependency postinstall scripts (esbuild, tree-sitter-cli, @vscode/vsce-sign) are all `node install.js`, which would require Node.js during `bun install`. esbuild ships its binary via the @esbuild/<platform> package, the tree-sitter binary is fetched by scripts/build-wasm.mjs via fetch, and vsce-sign signing is unused (token-based publish). Keeping this empty lets `bun install` run with no Node.js.",
  "trustedDependencies": [],
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.101.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.23.0",
    "tree-sitter-cli": "0.25.10",
    "typescript": "^5.5.0",
    "web-tree-sitter": "0.25.10"
  }
}
