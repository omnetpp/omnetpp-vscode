{
  "name": "omnetpp-vscode",
  "displayName": "OMNeT++ Development Environment",
  "description": "Language server and editor support for the OMNeT++ NED, MSG and INI languages",
  "version": "0.4.0",
  "publisher": "opensim",
  "repository": "https://github.com/omnetpp/omnetpp-vscode",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "opp_lint": "./dist/opp_lint.js",
    "opp_neddoc": "./dist/opp_neddoc.js"
  },
  "activationEvents": [
    "workspaceContains:**/*.ned",
    "onLanguage:OMNeT++ NED",
    "onLanguage:OMNeT++ MSG",
    "onLanguage:OMNeT++ INI"
  ],
  "workspaces": [
    "shared",
    "server",
    "client",
    "mcp"
  ],
  "scripts": {
    "build:wasm": "bun ./scripts/build-wasm.mjs",
    "compile": "bun ./node_modules/typescript/bin/tsc --build",
    "watch": "bun ./node_modules/typescript/bin/tsc --build --watch",
    "bundle": "bun ./esbuild.mjs",
    "bundle:watch": "bun ./esbuild.mjs --watch",
    "dev:build": "bun run copy:assets && bun run bundle",
    "copy:assets": "bun ./scripts/copy-assets.mjs",
    "prepackage": "bun run compile && bun run build:wasm && bun run copy:assets && bun ./esbuild.mjs --production",
    "test": "bun run compile && bun test ./shared/src/test ./server/src/test ./client/webview/src/test ./client/worker/src/test",
    "package": "bun run prepackage && bun ./node_modules/@vscode/vsce/vsce package --no-dependencies",
    "deploy": "bun run prepackage && bun ./node_modules/@vscode/vsce/vsce publish --no-dependencies"
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "omnetpp.liveModel",
        "label": "OMNeT++ NED/MSG/INI (live)"
      }
    ],
    "languages": [
      {
        "id": "OMNeT++ NED",
        "extensions": [
          ".ned"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "OMNeT++ MSG",
        "extensions": [
          ".msg"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "OMNeT++ INI",
        "extensions": [
          ".ini"
        ],
        "configuration": "./language-configuration-ini.json"
      }
    ],
    "snippets": [
      {
        "language": "OMNeT++ NED",
        "path": "./snippets/ned.json"
      },
      {
        "language": "OMNeT++ INI",
        "path": "./snippets/ini.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omnetpp",
          "title": "OMNeT++",
          "icon": "media/omnetpp.svg"
        }
      ],
      "panel": [
        {
          "id": "omnetppEventLog",
          "title": "OMNeT++ Event Log",
          "icon": "media/omnetpp.svg"
        }
      ]
    },
    "views": {
      "omnetpp": [
        {
          "id": "omnetppActiveConfig",
          "name": "Configurations"
        },
        {
          "id": "omnetppModuleHierarchy",
          "name": "Module Hierarchy"
        },
        {
          "id": "omnetppModuleParams",
          "name": "Module Parameters"
        },
        {
          "id": "omnetppInheritance",
          "name": "NED Inheritance"
        },
        {
          "id": "omnetppUsedBy",
          "name": "Used By"
        }
      ],
      "omnetppEventLog": [
        {
          "id": "omnetppEventLogTable",
          "name": "Table",
          "type": "webview",
          "when": "omnetpp.eventlogOpen"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "omnetpp.sequenceChart",
        "displayName": "OMNeT++ Sequence Chart",
        "selector": [
          {
            "filenamePattern": "*.elog"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "omnetpp.showImpact",
        "title": "Show Impact (Reverse Dependencies)",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.pinType",
        "title": "Pin Type",
        "category": "OMNeT++",
        "icon": "$(pin)"
      },
      {
        "command": "omnetpp.unpinType",
        "title": "Unpin Type",
        "category": "OMNeT++",
        "icon": "$(pinned)"
      },
      {
        "command": "omnetpp.pinModule",
        "title": "Pin Module",
        "category": "OMNeT++",
        "icon": "$(pin)"
      },
      {
        "command": "omnetpp.unpinModule",
        "title": "Unpin Module",
        "category": "OMNeT++",
        "icon": "$(pinned)"
      },
      {
        "command": "omnetpp.pinParam",
        "title": "Pin Module",
        "category": "OMNeT++",
        "icon": "$(pin)"
      },
      {
        "command": "omnetpp.unpinParam",
        "title": "Unpin Module",
        "category": "OMNeT++",
        "icon": "$(pinned)"
      },
      {
        "command": "omnetpp.pinUsedBy",
        "title": "Pin",
        "category": "OMNeT++",
        "icon": "$(pin)"
      },
      {
        "command": "omnetpp.unpinUsedBy",
        "title": "Unpin",
        "category": "OMNeT++",
        "icon": "$(pinned)"
      },
      {
        "command": "omnetpp.setActiveConfiguration",
        "title": "Set as Active Configuration",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.clearActiveConfiguration",
        "title": "Clear Active Configuration",
        "category": "OMNeT++",
        "icon": "$(close)"
      },
      {
        "command": "omnetpp.setActiveConfigItem",
        "title": "Set as Active Config",
        "category": "OMNeT++",
        "icon": "$(check)"
      },
      {
        "command": "omnetpp.filterConfigurations",
        "title": "Filter Configurations",
        "category": "OMNeT++",
        "icon": "$(filter)"
      },
      {
        "command": "omnetpp.clearConfigurationsFilter",
        "title": "Clear Configurations Filter",
        "category": "OMNeT++",
        "icon": "$(clear-all)"
      },
      {
        "command": "omnetpp.refreshConfigurations",
        "title": "Refresh Configurations",
        "category": "OMNeT++",
        "icon": "$(refresh)"
      },
      {
        "command": "omnetpp.showNedPreview",
        "title": "Show Graphical Preview",
        "category": "OMNeT++",
        "icon": "$(open-preview)"
      },
      {
        "command": "omnetpp.generateNedDocumentation",
        "title": "Generate NED Documentation",
        "category": "OMNeT++",
        "icon": "$(book)"
      },
      {
        "command": "omnetpp.previewShowType",
        "title": "Show",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.previewBack",
        "title": "Back",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.previewForward",
        "title": "Forward",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.previewRelayout",
        "title": "Re-layout",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.previewExportSvg",
        "title": "Export as SVG...",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.previewExportPng",
        "title": "Export as PNG...",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.eventlog.showEventLogTable",
        "title": "Show Event Log Table",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.eventlog.refresh",
        "title": "Refresh Event Log",
        "category": "OMNeT++",
        "icon": "$(refresh)"
      },
      {
        "command": "omnetpp.eventlog.openFilter",
        "title": "Filter Event Log...",
        "category": "OMNeT++",
        "icon": "$(filter)"
      },
      {
        "command": "omnetpp.eventlog.gotoEvent",
        "title": "Go to Event...",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.eventlog.gotoSimulationTime",
        "title": "Go to Simulation Time...",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.eventlog.findText",
        "title": "Find in Event Log...",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.eventlog.findNext",
        "title": "Find Next in Event Log",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.eventlog.showBookmarks",
        "title": "Show Bookmarks...",
        "category": "OMNeT++",
        "icon": "$(bookmark)"
      },
      {
        "command": "omnetpp.eventlog.pinEventLogTable",
        "title": "Pin to This Event Log",
        "category": "OMNeT++",
        "icon": "$(pin)"
      },
      {
        "command": "omnetpp.eventlog.unpinEventLogTable",
        "title": "Unpin",
        "category": "OMNeT++",
        "icon": "$(pinned)"
      },
      {
        "command": "omnetpp.eventlog.exportSvg",
        "title": "Export to SVG...",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.eventlog.copyImage",
        "title": "Copy Image to Clipboard",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.eventlog.releaseMemory",
        "title": "Release Memory",
        "category": "OMNeT++"
      },
      {
        "command": "omnetpp.eventlog.resetViewState",
        "title": "Reset Event Log View State",
        "category": "OMNeT++"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "omnetpp.pinType",
          "when": "false"
        },
        {
          "command": "omnetpp.unpinType",
          "when": "false"
        },
        {
          "command": "omnetpp.pinModule",
          "when": "false"
        },
        {
          "command": "omnetpp.unpinModule",
          "when": "false"
        },
        {
          "command": "omnetpp.pinParam",
          "when": "false"
        },
        {
          "command": "omnetpp.unpinParam",
          "when": "false"
        },
        {
          "command": "omnetpp.pinUsedBy",
          "when": "false"
        },
        {
          "command": "omnetpp.unpinUsedBy",
          "when": "false"
        },
        {
          "command": "omnetpp.setActiveConfiguration",
          "when": "editorLangId == 'OMNeT++ INI'"
        },
        {
          "command": "omnetpp.clearActiveConfiguration",
          "when": "omnetpp.hasActiveConfig"
        },
        {
          "command": "omnetpp.setActiveConfigItem",
          "when": "false"
        },
        {
          "command": "omnetpp.filterConfigurations",
          "when": "true"
        },
        {
          "command": "omnetpp.clearConfigurationsFilter",
          "when": "omnetpp.configFilterActive"
        },
        {
          "command": "omnetpp.refreshConfigurations",
          "when": "true"
        },
        {
          "command": "omnetpp.showNedPreview",
          "when": "editorLangId == 'OMNeT++ NED'"
        },
        {
          "command": "omnetpp.previewShowType",
          "when": "false"
        },
        {
          "command": "omnetpp.previewBack",
          "when": "false"
        },
        {
          "command": "omnetpp.previewForward",
          "when": "false"
        },
        {
          "command": "omnetpp.previewRelayout",
          "when": "false"
        },
        {
          "command": "omnetpp.previewExportSvg",
          "when": "false"
        },
        {
          "command": "omnetpp.previewExportPng",
          "when": "false"
        },
        {
          "command": "omnetpp.eventlog.pinEventLogTable",
          "when": "false"
        },
        {
          "command": "omnetpp.eventlog.unpinEventLogTable",
          "when": "false"
        },
        {
          "command": "omnetpp.eventlog.resetViewState",
          "when": "omnetpp.eventlogOpen"
        }
      ],
      "webview/context": [
        {
          "command": "omnetpp.previewShowType",
          "when": "webviewId == 'omnetpp.nedPreview' && webviewSection == 'nedPreviewSub'",
          "group": "0_navigate@1"
        },
        {
          "command": "omnetpp.previewRelayout",
          "when": "webviewId == 'omnetpp.nedPreview' && webviewSection =~ /^nedPreview/",
          "group": "1_layout@1"
        },
        {
          "command": "omnetpp.previewExportSvg",
          "when": "webviewId == 'omnetpp.nedPreview' && webviewSection =~ /^nedPreview/",
          "group": "2_export@1"
        },
        {
          "command": "omnetpp.previewExportPng",
          "when": "webviewId == 'omnetpp.nedPreview' && webviewSection =~ /^nedPreview/",
          "group": "2_export@2"
        }
      ],
      "editor/context": [
        {
          "command": "omnetpp.showNedPreview",
          "when": "editorLangId == 'OMNeT++ NED'",
          "group": "navigation@1"
        },
        {
          "command": "omnetpp.setActiveConfiguration",
          "when": "editorLangId == 'OMNeT++ INI'",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "omnetpp.showNedPreview",
          "when": "editorLangId == 'OMNeT++ NED'",
          "group": "navigation"
        },
        {
          "command": "omnetpp.eventlog.refresh",
          "when": "activeCustomEditorId == 'omnetpp.sequenceChart'",
          "group": "navigation@1"
        },
        {
          "command": "omnetpp.eventlog.openFilter",
          "when": "activeCustomEditorId == 'omnetpp.sequenceChart'",
          "group": "navigation@2"
        },
        {
          "command": "omnetpp.eventlog.showEventLogTable",
          "when": "activeCustomEditorId == 'omnetpp.sequenceChart'",
          "group": "navigation@3"
        },
        {
          "command": "omnetpp.eventlog.showBookmarks",
          "when": "activeCustomEditorId == 'omnetpp.sequenceChart'",
          "group": "navigation@4"
        },
        {
          "command": "omnetpp.eventlog.exportSvg",
          "when": "activeCustomEditorId == 'omnetpp.sequenceChart'",
          "group": "1_export@1"
        },
        {
          "command": "omnetpp.eventlog.copyImage",
          "when": "activeCustomEditorId == 'omnetpp.sequenceChart'",
          "group": "1_export@2"
        },
        {
          "command": "omnetpp.eventlog.releaseMemory",
          "when": "activeCustomEditorId == 'omnetpp.sequenceChart'",
          "group": "2_memory@1"
        }
      ],
      "view/title": [
        {
          "command": "omnetpp.unpinType",
          "when": "view == omnetppInheritance && omnetpp.typePinned",
          "group": "navigation"
        },
        {
          "command": "omnetpp.unpinModule",
          "when": "view == omnetppModuleHierarchy && omnetpp.modulePinned",
          "group": "navigation"
        },
        {
          "command": "omnetpp.unpinParam",
          "when": "view == omnetppModuleParams && omnetpp.paramPinned",
          "group": "navigation"
        },
        {
          "command": "omnetpp.pinUsedBy",
          "when": "view == omnetppUsedBy && omnetpp.usedByHasTarget && !omnetpp.usedByPinned",
          "group": "navigation"
        },
        {
          "command": "omnetpp.unpinUsedBy",
          "when": "view == omnetppUsedBy && omnetpp.usedByPinned",
          "group": "navigation"
        },
        {
          "command": "omnetpp.filterConfigurations",
          "when": "view == omnetppActiveConfig",
          "group": "navigation@1"
        },
        {
          "command": "omnetpp.clearConfigurationsFilter",
          "when": "view == omnetppActiveConfig && omnetpp.configFilterActive",
          "group": "navigation@2"
        },
        {
          "command": "omnetpp.clearActiveConfiguration",
          "when": "view == omnetppActiveConfig && omnetpp.hasActiveConfig",
          "group": "navigation@3"
        },
        {
          "command": "omnetpp.refreshConfigurations",
          "when": "view == omnetppActiveConfig",
          "group": "navigation@4"
        },
        {
          "command": "omnetpp.eventlog.refresh",
          "when": "view == omnetppEventLogTable",
          "group": "navigation@1"
        },
        {
          "command": "omnetpp.eventlog.openFilter",
          "when": "view == omnetppEventLogTable",
          "group": "navigation@2"
        },
        {
          "command": "omnetpp.eventlog.showBookmarks",
          "when": "view == omnetppEventLogTable",
          "group": "navigation@3"
        },
        {
          "command": "omnetpp.eventlog.pinEventLogTable",
          "when": "view == omnetppEventLogTable && !omnetpp.eventlogTablePinned",
          "group": "navigation@4"
        },
        {
          "command": "omnetpp.eventlog.unpinEventLogTable",
          "when": "view == omnetppEventLogTable && omnetpp.eventlogTablePinned",
          "group": "navigation@4"
        },
        {
          "command": "omnetpp.eventlog.releaseMemory",
          "when": "view == omnetppEventLogTable",
          "group": "2_memory@1"
        }
      ],
      "view/item/context": [
        {
          "command": "omnetpp.setActiveConfigItem",
          "when": "view == omnetppActiveConfig && viewItem == omnetppConfig",
          "group": "inline"
        },
        {
          "command": "omnetpp.setActiveConfigItem",
          "when": "view == omnetppActiveConfig && viewItem == omnetppConfig",
          "group": "1_config"
        },
        {
          "command": "omnetpp.pinType",
          "when": "view == omnetppInheritance && viewItem == nedTypeUnpinned",
          "group": "inline"
        },
        {
          "command": "omnetpp.pinType",
          "when": "view == omnetppInheritance && viewItem == nedTypeUnpinned",
          "group": "1_pin"
        },
        {
          "command": "omnetpp.unpinType",
          "when": "view == omnetppInheritance && viewItem == nedTypePinned",
          "group": "inline"
        },
        {
          "command": "omnetpp.unpinType",
          "when": "view == omnetppInheritance && viewItem == nedTypePinned",
          "group": "1_pin"
        },
        {
          "command": "omnetpp.pinModule",
          "when": "view == omnetppModuleHierarchy && viewItem == nedModuleUnpinned",
          "group": "inline"
        },
        {
          "command": "omnetpp.pinModule",
          "when": "view == omnetppModuleHierarchy && viewItem == nedModuleUnpinned",
          "group": "1_pin"
        },
        {
          "command": "omnetpp.unpinModule",
          "when": "view == omnetppModuleHierarchy && viewItem == nedModulePinned",
          "group": "inline"
        },
        {
          "command": "omnetpp.unpinModule",
          "when": "view == omnetppModuleHierarchy && viewItem == nedModulePinned",
          "group": "1_pin"
        },
        {
          "command": "omnetpp.pinParam",
          "when": "view == omnetppModuleParams && viewItem == nedParamUnpinned",
          "group": "inline"
        },
        {
          "command": "omnetpp.pinParam",
          "when": "view == omnetppModuleParams && viewItem == nedParamUnpinned",
          "group": "1_pin"
        },
        {
          "command": "omnetpp.unpinParam",
          "when": "view == omnetppModuleParams && viewItem == nedParamPinned",
          "group": "inline"
        },
        {
          "command": "omnetpp.unpinParam",
          "when": "view == omnetppModuleParams && viewItem == nedParamPinned",
          "group": "1_pin"
        }
      ]
    },
    "grammars": [
      {
        "language": "OMNeT++ NED",
        "scopeName": "source.ned",
        "path": "./syntaxes/ned.tmLanguage.json",
        "unbalancedBracketScopes": ["comment", "string"]
      },
      {
        "language": "OMNeT++ MSG",
        "scopeName": "source.msg",
        "path": "./syntaxes/omnetpp-msg.tmLanguage.json",
        "unbalancedBracketScopes": ["comment", "string"]
      },
      {
        "language": "OMNeT++ INI",
        "scopeName": "source.omnetpp-ini",
        "path": "./syntaxes/omnetpp-ini.tmLanguage.json",
        "unbalancedBracketScopes": ["comment", "string"]
      }
    ],
    "keybindings": [
      {
        "command": "omnetpp.previewBack",
        "key": "alt+left",
        "mac": "ctrl+-",
        "when": "activeWebviewPanelId == 'omnetpp.nedPreview'"
      },
      {
        "command": "omnetpp.previewForward",
        "key": "alt+right",
        "mac": "ctrl+shift+-",
        "when": "activeWebviewPanelId == 'omnetpp.nedPreview'"
      },
      {
        "command": "omnetpp.eventlog.gotoEvent",
        "key": "ctrl+g",
        "mac": "cmd+g",
        "when": "activeCustomEditorId == 'omnetpp.sequenceChart' || view == 'omnetppEventLogTable'"
      },
      {
        "command": "omnetpp.eventlog.gotoSimulationTime",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "activeCustomEditorId == 'omnetpp.sequenceChart' || view == 'omnetppEventLogTable'"
      },
      {
        "command": "omnetpp.eventlog.findNext",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "activeCustomEditorId == 'omnetpp.sequenceChart' || view == 'omnetppEventLogTable'"
      },
      {
        "command": "omnetpp.eventlog.showBookmarks",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "activeCustomEditorId == 'omnetpp.sequenceChart' || view == 'omnetppEventLogTable'"
      }
    ],
    "configuration": {
      "title": "OMNeT++",
      "properties": {
        "omnetpp.nedPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Semicolon-separated list of additional NED source root directories (like the `ned-path` config option). Used in addition to source roots discovered from `.nedfolders`/`package.ned`."
        },
        "omnetpp.installDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to an OMNeT++ installation root. When set (or auto-detected), enables enriched features such as a live config-option registry and bundled NED libraries."
        },
        "omnetpp.neddoc.format": {
          "type": "string",
          "enum": ["html", "html-readthedocs", "html-material", "markdown", "rst"],
          "enumDescriptions": [
            "Browsable static site with a navigation sidebar and client-side search.",
            "Same static site, styled like the popular Read the Docs (Sphinx RTD) theme.",
            "The Eclipse IDE's neddoc look & feel (Material template, flat file layout).",
            "Markdown files with a SUMMARY.md navigation index.",
            "Sphinx-ready reStructuredText files with toctrees and :ref: labels."
          ],
          "default": "html",
          "order": 1,
          "markdownDescription": "Default output format of the *Generate NED Documentation* command (the command still lets you pick a different format per run)."
        },
        "omnetpp.neddoc.outputDirectory": {
          "type": "string",
          "default": "doc/neddoc",
          "order": 2,
          "markdownDescription": "Where the generated documentation is written; relative paths are resolved against the workspace folder. Existing files are overwritten, but the directory is not cleaned first."
        },
        "omnetpp.neddoc.title": {
          "type": "string",
          "default": "",
          "order": 3,
          "markdownDescription": "Documentation title shown on the overview page and in the navigation header. Empty = the workspace folder name."
        },
        "omnetpp.neddoc.excludeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "order": 4,
          "markdownDescription": "Directories excluded from the documentation, as workspace-relative glob-ish patterns (`*` and `**` supported; a bare name matches at any depth), e.g. `examples` or `src/legacy/**`."
        },
        "omnetpp.neddoc.networkDiagrams": {
          "type": "boolean",
          "default": true,
          "order": 10,
          "markdownDescription": "Render the graphical module figure (submodules, icons, connections) on type pages."
        },
        "omnetpp.neddoc.usageDiagrams": {
          "type": "boolean",
          "default": true,
          "order": 11,
          "markdownDescription": "Per-type usage diagrams (the type, the types it uses, and the types using it)."
        },
        "omnetpp.neddoc.inheritanceDiagrams": {
          "type": "boolean",
          "default": true,
          "order": 12,
          "markdownDescription": "Per-type inheritance diagrams (direct supertypes, interfaces, subtypes and implementors)."
        },
        "omnetpp.neddoc.fullUsageDiagram": {
          "type": "boolean",
          "default": false,
          "order": 13,
          "markdownDescription": "Generate the project-wide *Full NED/MSG Usage Diagram* pages. Can get large on big projects."
        },
        "omnetpp.neddoc.fullInheritanceDiagram": {
          "type": "boolean",
          "default": false,
          "order": 14,
          "markdownDescription": "Generate the project-wide *Full NED/MSG Inheritance Diagram* pages. Can get large on big projects."
        },
        "omnetpp.neddoc.messageDefinitions": {
          "type": "boolean",
          "default": true,
          "order": 15,
          "markdownDescription": "Document MSG types (messages, packets, classes, structs, enums) too."
        },
        "omnetpp.neddoc.sourceListings": {
          "type": "boolean",
          "default": true,
          "order": 16,
          "markdownDescription": "Include the NED/MSG source of each type on its page."
        },
        "omnetpp.neddoc.automaticHyperlinks": {
          "type": "boolean",
          "default": true,
          "order": 17,
          "markdownDescription": "Automatically hyperlink every known type name mentioned in doc comments (`\\Name` suppresses a link). When off, only `~Name` tilde references are linked and unknown `~name`s are flagged."
        },
        "omnetpp.neddoc.includeBuiltins": {
          "type": "boolean",
          "default": false,
          "order": 18,
          "markdownDescription": "Also document the built-in NED types (`ned.DelayChannel`, `ned.DatarateChannel`, ...)."
        },
        "omnetpp.neddoc.customCss": {
          "type": "string",
          "default": "",
          "order": 20,
          "markdownDescription": "Path to a stylesheet that replaces the generated `style.css` (the html, html-readthedocs and html-material formats); relative paths are resolved against the workspace folder."
        },
        "omnetpp.neddoc.doxytagsFile": {
          "type": "string",
          "default": "",
          "order": 21,
          "markdownDescription": "Path to a doxygen tag file (`GENERATE_TAGFILE` output of a doxygen run on the C++ sources). When set, simple-module and message pages link to the C++ documentation (\"C++ definition\"). Doxygen itself is never executed."
        },
        "omnetpp.neddoc.doxyUrlPrefix": {
          "type": "string",
          "default": "",
          "order": 22,
          "markdownDescription": "URL or path prefix for the doxygen links (e.g. `../doxy`), joined with the page names from the tag file."
        },
        "omnetpp.diagnostics.scope": {
          "type": "string",
          "enum": [
            "workspace",
            "openFiles"
          ],
          "enumDescriptions": [
            "Report problems for every NED/MSG/INI file in the workspace, even ones that aren't open in an editor.",
            "Report problems only for files currently open in an editor."
          ],
          "default": "workspace",
          "markdownDescription": "Which files contribute problem markers to the Problems view. `workspace` analyses the whole project so errors in unopened files stay visible; `openFiles` restricts diagnostics to the editors you have open."
        },
        "omnetpp.codeLens.iniParams": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a CodeLens on INI parameter-assignment lines with the count of matching module parameters (in the network of the section, or of the active configuration for `[General]` lines). Clicking it peeks the matched NED parameter declarations."
        },
        "omnetpp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the OMNeT++ language server."
        },
        "omnetpp.sequenceChart.defaultTimelineMode": {
          "type": "string",
          "enum": [
            "SIMULATION_TIME",
            "EVENT_NUMBER",
            "STEP",
            "NONLINEAR"
          ],
          "default": "SIMULATION_TIME",
          "markdownDescription": "The Sequence Chart's initial timeline mode for a freshly opened `.elog` file. Only applies until the user (or a previous session) picks a mode for that specific file -- a per-file remembered timeline mode always takes priority over this default."
        },
        "omnetpp.sequenceChart.fontSize": {
          "type": "number",
          "default": 0,
          "markdownDescription": "Font size (px) used for chart labels (axis labels, message names, time-difference/info-panel text, rotated axis-header text); `0` keeps the chart's own built-in default (12px). This is a uniform scale of the built-in sizes, not real font-metrics-aware relayout -- at sizes far from the default, label spacing/gutter widths may look slightly cramped or loose."
        },
        "omnetpp.sequenceChart.styleRules": {
          "type": "array",
          "default": [],
          "markdownDescription": "Reserved for a later phase's module-specific chart styling rules."
        },
        "omnetpp.eventlog.followEndOnAppend": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When a `.elog` file is opened for the first time (no remembered scroll position for it yet), start already following the end of the log -- as if End had just been pressed -- so a still-appending live run stays in view without an extra keypress. Re-read on every Sequence Chart webview reload, so a change applies the next time the file is (re)opened."
        },
        "omnetpp.eventlog.maxEngineMemoryMB": {
          "type": "number",
          "default": 0,
          "markdownDescription": "Soft memory budget (MB) for the per-file eventlog engine's parsed-event cache; `0` uses the engine's built-in default (roughly 50,000 events). This is a rough heuristic (~2 KB/cached event), not a hard ceiling. Takes effect the next time the file is opened (baked into the engine at open time, not live-pushed to an already-open file -- use \"Release Memory\" to shrink an already-open file's cache immediately)."
        },
        "omnetpp.eventlog.pollIntervalMs": {
          "type": "number",
          "default": 3000,
          "markdownDescription": "Fallback poll interval (ms) for detecting `.elog` file changes when filesystem-watch events don't fire (e.g. some network mounts, or a rename/recreate during a live run). `0` disables polling (filesystem-watch events remain the only change signal). Takes effect the next time the file is opened."
        }
      }
    }
  },
  "comment:trustedDependencies": "Intentionally empty: dependency postinstall scripts (esbuild, tree-sitter-cli, @vscode/vsce-sign) are all `node install.js`, which would require Node.js during `bun install`. esbuild ships its binary via the @esbuild/<platform> package, the tree-sitter binary is fetched by scripts/build-wasm.mjs via fetch, and vsce-sign signing is unused (token-based publish). Keeping this empty lets `bun install` run with no Node.js.",
  "trustedDependencies": [],
