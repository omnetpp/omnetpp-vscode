{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    // web-tree-sitter (and the MCP SDK) expose their entry/subpaths via package.json
    // "exports" maps, which only node16/nodenext resolution understands. These packages
    // have no "type":"module", so tsc still emits CommonJS for esbuild to bundle. The
    // test suite runs via bun:test directly over the TypeScript sources (shared/src/test).
    "module": "node16",
    "moduleResolution": "node16",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  }
}
