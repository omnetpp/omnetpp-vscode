{
  "name": "@omnetpp/shared",
  "version": "0.1.0",
  "description": "Pure-TypeScript semantic core for OMNeT++ NED/MSG/INI (parser wrappers, type model, analyzers)",
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./node": {
      "types": "./out/node/index.d.ts",
      "default": "./out/node/index.js"
    },
    "./protocol": {
      "types": "./out/protocol.d.ts",
      "default": "./out/protocol.js"
    },
    "./preview": {
      "types": "./out/preview.d.ts",
      "default": "./out/preview.js"
    },
    "./eventlog": {
      "types": "./out/eventlog/index.d.ts",
      "default": "./out/eventlog/index.js"
    },
    "./match": {
      "types": "./out/match/index.d.ts",
      "default": "./out/match/index.js"
    }
  },
  "dependencies": {
    "web-tree-sitter": "0.25.10"
  }
}
