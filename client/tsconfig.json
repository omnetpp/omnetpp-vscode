{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./out",
    // Keep the incremental-build state inside out/ so deleting out/ yields a
    // coherent clean state (a surviving tsbuildinfo would make tsc skip re-emit).
    "tsBuildInfoFile": "./out/tsconfig.tsbuildinfo",
    "lib": ["ES2021"],
    "types": ["node", "vscode"],
    // The MCP SDK exposes its subpaths via a package.json "exports" map; "bundler"
    // resolution reads it (and keeps extensionless relative imports). The runtime
    // artifact is the esbuild bundle, so this only affects type-checking.
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "references": [{ "path": "../shared" }],
  "include": ["src/**/*.ts"]
}
