// Launch configurations for developing the OMNeT++ extension.
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "npm: dev:build"
		},
		{
			"name": "Attach to Server",
			"type": "node",
			"request": "attach",
			"port": 6009,
			"restart": true,
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			]
		}
	],
	"compounds": [
		{
			"name": "Extension + Server",
			"configurations": ["Launch Extension", "Attach to Server"]
		}
	]
}
